#!/bin/sh
# Register and start the split tunneling helper. The binary is installed
# root-owned, which is what makes running it as root safe.
set -e

if [ "$1" = "configure" ]; then
  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable nimbus-helper.service >/dev/null 2>&1 || true
    systemctl restart nimbus-helper.service >/dev/null 2>&1 || true
  fi
fi

exit 0
